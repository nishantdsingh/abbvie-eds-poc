{
  "definitions": [
    {
      "title": "Cta",
      "id": "cta",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Cta",
              "model": "cta",
              "label": "Button",
              "href": "/link",
              "ariaLabel": "",
              "ctaTarget": "_self",
              "iconType": "none",
              "iconFont": "",
              "iconImage": "",
              "iconPosition": "i-a",
              "modalId": "",
              "anchorId": "",
              "analyticsInteractionId": "",
              "ariaHidden": "false",
              "classes": "abbv-button-primary",
              "language": "lang:none",
              "blockId": "id:"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "cta",
      "fields": [
        {
          "component": "tab",
          "label": "Overview",
          "name": "tab-overview"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Button Text",
          "value": "Button"
        },
        {
          "component": "aem-content",
          "name": "href",
          "label": "Target"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ariaLabel",
          "label": "ARIA Label",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "ctaTarget",
          "label": "Click Behavior",
          "value": "_self",
          "options": [
            { "name": "Same Tab", "value": "_self" },
            { "name": "New Tab", "value": "_blank" },
            { "name": "Modal", "value": "new-modal" },
            { "name": "Hidden Panel", "value": "new-hidden-panel" },
            { "name": "Switch View", "value": "switch-view" },
            { "name": "Indication Selection", "value": "indicationSelection" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "modalId",
          "label": "Modal ID",
          "value": "",
          "description": "When set, renders a <button> with data-modal-id instead of an <a> link."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "iconType",
          "label": "Icon Type",
          "value": "none",
          "description": "Icon type for the button",
          "options": [
            { "name": "None", "value": "none" },
            { "name": "Icon Font", "value": "icon-font" },
            { "name": "Image", "value": "image" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "iconFont",
          "label": "Button Font Icon",
          "value": "",
          "description": "Font icon name for button",
          "condition": { "===": [{ "var": "iconType" }, "icon-font"] }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "iconImage",
          "label": "Button Image Icon",
          "description": "Image icon for button",
          "multi": false,
          "condition": { "===": [{ "var": "iconType" }, "image"] }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "iconPosition",
          "label": "Icon Position",
          "value": "i-a",
          "description": "Select whether the icon is placed before or after your button text",
          "options": [
            { "name": "Before (left)", "value": "i-b" },
            { "name": "After (right)", "value": "i-a" }
          ],
          "condition": { "in": [{ "var": "iconType" }, ["icon-font", "image"]] }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "ariaHidden",
          "label": "Prevent screen readers from announcing this CTA",
          "value": false
        },
        {
          "component": "tab",
          "label": "Styles",
          "name": "tab-styles"
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "classes",
          "label": "Variant",
          "options": [
            { "name": "Primary (default)", "value": "abbv-button-primary" },
            { "name": "Secondary", "value": "abbv-button-secondary" },
            { "name": "Tertiary", "value": "abbv-button-tertiary" },
            { "name": "Plain link", "value": "abbv-button-plain" },
            { "name": "Toggle (round)", "value": "abbv-switch-round" },
            { "name": "Toggle (square)", "value": "abbv-switch-square" }
          ]
        },
        {
          "component": "tab",
          "label": "Common Properties",
          "name": "tab-common"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchorId",
          "label": "Anchor ID",
          "value": "",
          "description": "Optional id attribute for deep-linking to this CTA."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "analyticsInteractionId",
          "label": "Analytics Interaction ID",
          "value": "",
          "description": "Unique ID pushed to GTM dataLayer on click."
        },
        {
          "...": "../../models/_common-properties.json#/common-prop"
        }
      ]
    }
  ],
  "filters": []
}
